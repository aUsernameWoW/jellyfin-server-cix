# Jellyfin default configuration for CIX
# Loaded by jellyfin.service as an EnvironmentFile. systemd does not expand
# variables inside this file, so every value must be written out in full.

# Directory where program data is stored
JELLYFIN_DATA_DIR="/var/lib/jellyfin"

# Directory where configuration is stored
JELLYFIN_CONFIG_DIR="/etc/jellyfin"

# Directory where logs are stored
JELLYFIN_LOG_DIR="/var/log/jellyfin"

# Directory where cache is stored
JELLYFIN_CACHE_DIR="/var/cache/jellyfin"

# Web client installed by jellyfin-web-cix
JELLYFIN_WEB_OPT="--webdir=/usr/share/jellyfin/web"

# FFmpeg with V4L2M2M support. The default is the cix-ffmpeg package from
# https://github.com/radxa-pkg/cix-prebuilt/releases, whose libraries live in
# /usr/share/cix/lib (not on the default linker path).
# To use another FFmpeg (e.g. a CIX-patched /usr/bin/ffmpeg), change the path
# below and remove LD_LIBRARY_PATH.
JELLYFIN_FFMPEG_OPT="--ffmpeg=/usr/share/cix/bin/ffmpeg"
LD_LIBRARY_PATH="/usr/share/cix/lib"

# Uncomment to run without hosting the web client
#JELLYFIN_NOWEBAPP_OPT="--nowebclient"

# Additional command line options
JELLYFIN_ADDITIONAL_OPTS=""
